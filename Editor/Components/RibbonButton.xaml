<UserControl x:Class="Editor.Components.RibbonButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Editor.Components"
             mc:Ignorable="d" 
             d:DesignHeight="76" d:DesignWidth="64">

	<Grid>
		<Image x:Name="Icon" VerticalAlignment="Top" Height="64" Source="{Binding IconSource}"/>
		<Label x:Name="Name" Height="12" VerticalAlignment="Bottom" Content="{Binding Title}"/>
	</Grid>
</UserControl>
