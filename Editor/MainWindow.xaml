<Window x:Class="Editor.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:Editor"
		mc:Ignorable="d"
		Title="Refraction Editor" Height="1080" Width="1920">
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/DefaultStyle.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Rectangle x:Name="Viewport" HorizontalAlignment="Center" Height="346" Margin="0,97,0,0" Stroke="Black" VerticalAlignment="Top" Width="645"/>
		<Canvas Height="96" VerticalAlignment="Top">
			<TabControl x:Name="Ribbon" Height="96" Width="1920">
				<TabItem Header="General">
					<StackPanel Orientation="Horizontal">
						<Image Height="48" Width="48" />
					</StackPanel>
				</TabItem>
				<TabItem Header="Debug" Padding="12,2,12,2">
				</TabItem>
				<TabItem Header="Test">
				</TabItem>
			</TabControl>
		</Canvas>
	</Grid>
</Window>
